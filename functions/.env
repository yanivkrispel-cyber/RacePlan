# Send to watch (docs/GARMIN.md). true once the three GARMIN_* secrets are set.
GARMIN_ENABLED=true
# Who may connect Garmin: * = every signed-in user with a verified email (Kris 3.11.2026: "everyone, future users
# too"); or a comma-separated list of emails to close it to a few. This repo is public: never list users here.
GARMIN_ALLOW=*
