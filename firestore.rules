rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function email()    { return request.auth.token.email; }
    function isOwner()  { return verified() && email() == 'yaniv.krispel@gmail.com'; }

    match /users/{uid} {
      // Each user reads/writes only their own profile doc (email, lastSeenAt,
      // visits). The owner can also read the whole collection = the customer list.
      allow get, create, update: if signedIn() && request.auth.uid == uid;
      allow get, list:            if isOwner();
      allow delete:               if false;

      // The athlete bank — owner only, and only on their own subtree.
      match /bank/{doc=**} {
        allow read, write: if isOwner() && request.auth.uid == uid;
      }

      // "My plans" — every signed-in user's own saved-plan store, private to
      // that account. (users/{uid} list above does not recurse into this.)
      match /plans/{doc=**} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // The shared race library. Any signed-in user can read a single race, but a
    // list query is only allowed for the owner, or when it is scoped to
    // listed == true — so hidden races never reach a non-owner. Only the coach
    // adds / edits / removes races.
    match /races/{raceId} {
      allow get:                    if signedIn();
      allow list:                   if isOwner() || (signedIn() && resource.data.listed == true);
      allow create, update, delete: if isOwner();
    }

    // Short share links (/p/{id}). The random id is the capability: any
    // signed-in user holding the link can read that one doc; no listing, and a
    // share is immutable once written.
    match /shares/{id} {
      allow get:    if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.json is string
        && request.resource.data.json.size() < 60000
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(['json', 'ownerUid', 'createdAt']);
      allow list, update, delete: if false;
    }

    // Community route submissions. Any verified user may propose a GPX route
    // for a race; only the coach reads the queue and approves / rejects.
    // Approval itself writes the course onto races/{id} (owner-only above).
    // raceId is either an existing race's id, or null when the submitter's
    // race isn't in the catalog yet — then raceName is the free-text name the
    // coach turns into a real race doc on approval.
    match /routeSubmissions/{id} {
      allow create: if verified()
        && request.auth.uid == request.resource.data.submitterUid
        && request.resource.data.status == 'pending'
        && ((request.resource.data.raceId is string && request.resource.data.raceId.size() > 0)
            || (request.resource.data.raceId == null
                && request.resource.data.raceName is string
                && request.resource.data.raceName.size() > 0))
        && request.resource.data.createdAt == request.time
        && request.resource.data.trackFlat is list
        && request.resource.data.trackFlat.size() < 1200
        && (!('profileFlat' in request.resource.data)
            || request.resource.data.profileFlat == null
            || request.resource.data.profileFlat.size() < 800);
      allow read, list, update, delete: if isOwner();
    }
  }
}
